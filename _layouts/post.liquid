---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% assign url_beginning = page.url | slice: 0, 6 %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% comment %}
  Auto-number post sections (h2 -> 1., 2., ... ; h3 -> 1.1, 1.2, ...).
  Numbers are generated by CSS, so they always stay correct as you
  insert/reorder sections. Remove this block to opt out.
{% endcomment %}
<style type="text/css">
  .post-content {
    counter-reset: section;
  }
  .post-content h2 {
    counter-reset: subsection;
    counter-increment: section;
  }
  .post-content h2::before {
    content: counter(section) ".\00a0";
  }
  .post-content h3 {
    counter-increment: subsection;
  }
  .post-content h3::before {
    content: counter(section) "." counter(subsection) ".\00a0";
  }

  /* The theme sets overflow-x:auto on display math; per the CSS spec that makes
     overflow-y compute to auto too, and MathJax's hidden accessibility MathML
     (mjx-assistive-mml) inflates scrollHeight ~10x, so every equation shows a
     phantom vertical scrollbar. Keep horizontal scroll for wide equations, but
     kill the vertical one. */
  mjx-container[jax="CHTML"][display="true"] {
    overflow-y: hidden;
  }
</style>

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      Created on {{ page.date | date: '%B %d, %Y' }}
      {% if page.author %}by {{ page.author }}{% endif %}
      {% assign last_date = page.last_modified_at | default: page.last_updated %}
      {% if last_date %}, last updated on {{ last_date | date: '%B %d, %Y' }}{% endif %}
      {% if page.meta %}• {{ page.meta }}{% endif %}
    </p>
    <p class="post-tags">
      {% if url_beginning == '/blog/' %}
        <a href="{{ year | prepend: '/blog/' | relative_url }}"> <i class="fa-solid fa-calendar fa-sm"></i> {{ year }} </a>
      {% else %}
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
      {% endif %}
      {% if tags != '' %}
        &nbsp; &middot; &nbsp;
        {% for tag in page.tags %}
          {% if url_beginning == '/blog/' %}
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
          {% else %}
            <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% if categories != '' %}
        &nbsp; &middot; &nbsp;
        {% for category in page.categories %}
          {% if url_beginning == '/blog/' %}
            <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
          {% else %}
            <i class="fa-solid fa-tag fa-sm"></i> {{ category }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}
    </p>
  </header>

  {% include series_nav.liquid %}

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% include series_nav.liquid position="bottom" %}

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}

  {% if site.related_blog_posts and site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% if site.plugins contains 'al_comments' %}
    {% include plugins/al_comments.liquid %}
  {% endif %}
</div>
